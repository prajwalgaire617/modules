<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_iframe" model="ir.ui.view">
        <field name="name">product.template.form.iframe</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Add fields in the General Information tab -->
            <xpath expr="//group[@name='group_general']" position="after">
                <group string="Website Iframe Settings" name="iframe_settings">
                    <group>
                        <field name="use_iframe"/>
                    </group>
                    <group>
                        <field name="iframe_url" 
                               placeholder="https://www.youtube.com/embed/VIDEO_ID"
                               attrs="{'invisible': [('use_iframe', '=', False)], 
                                       'required': [('use_iframe', '=', True)]}"/>
                        <field name="iframe_height" 
                               attrs="{'invisible': [('use_iframe', '=', False)]}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
