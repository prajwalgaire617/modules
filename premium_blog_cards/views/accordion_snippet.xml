<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Blog Accordion Snippet Template -->
<template id="s_blog_accordion" name="Blog Accordion">
    <section class="s_blog_accordion pt48 pb48">
        <div class="container">
            <h2 class="text-center mb-5">Explore Our List of Blogs</h2>
            <div id="blogAccordion" class="accordion">
                <!-- Static placeholder for Edit mode; will be populated by JS publicWidget on frontend -->
                <div class="card border-0 mb-2 shadow-sm">
                    <div class="card-header bg-white p-0">
                        <h5 class="mb-0">
                            <button class="btn btn-link btn-block text-left d-flex justify-content-between align-items-center p-3 text-dark font-weight-bold" type="button">
                                <span>Loading blogs...</span>
                                <i class="fa fa-chevron-down small"/>
                            </button>
                        </h5>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

<!-- Snippet Options -->
<template id="s_blog_accordion_options" inherit_id="website.snippet_options">
    <xpath expr="." position="inside">
        <div data-js="s_blog_accordion" data-selector=".s_blog_accordion">
            <we-select string="Layout" data-no-preview="true">
                <we-button data-select-class="" data-name="list_layout">List</we-button>
                <we-button data-select-class="s_blog_accordion_grid_2" data-name="grid_2_layout">Grid (2 cols)</we-button>
                <we-button data-select-class="s_blog_accordion_grid_3" data-name="grid_3_layout">Grid (3 cols)</we-button>
                <we-button data-select-class="s_blog_accordion_grid_4" data-name="grid_4_layout">Grid (4 cols)</we-button>
                <we-button data-select-class="s_blog_accordion_grid_5" data-name="grid_5_layout">Grid (5 cols)</we-button>
                <we-button data-select-class="s_blog_accordion_grid_6" data-name="grid_6_layout">Grid (6 cols)</we-button>
            </we-select>
        </div>
    </xpath>
</template>

<!-- Register the snippet -->
<template id="s_blog_accordion_registration" inherit_id="website.snippets" name="Blog Accordion Registration">
    <xpath expr="//div[@id='snippet_content']//div[contains(@class, 'o_panel_body')]" position="inside">
        <t t-snippet="premium_blog_cards.s_blog_accordion" t-thumbnail="/website/static/src/img/snippets_thumbs/s_faq_collapse.svg"/>
    </xpath>
</template>

</odoo>
