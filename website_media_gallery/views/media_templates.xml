<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="media_gallery_page" name="Media Gallery Page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="s_media_gallery pt-5 pb-5" style="background: #f8f9fa;">
                    <div class="container">
                        <h1 class="text-center mb-5">Complete Media Gallery</h1>
                        
                        <t t-if="not attachments">
                            <div class="text-center py-5">
                                <i class="fa fa-image fa-5x text-muted mb-4" style="opacity: 0.3;"></i>
                                <h3 class="text-muted">No Media Found</h3>
                                <p class="text-muted">Upload some images to display them here</p>
                            </div>
                        </t>
                        
                        <t t-if="attachments">
                            <div class="media-grid">
                                <t t-foreach="attachments" t-as="att">
                                    <div class="media-card">
<img t-att-src="'/web/image/%s' % att.id" 
     t-att-alt="att.name or 'Image'"
     t-att-data-name="att.name"
     loading="lazy"
     class="media-item"/>
                                    </div>
                                </t>
                            </div>
                            
                            <!-- Pagination -->
                            <div class="text-center mt-5">
                                <nav>
                                    <ul class="pagination justify-content-center">
                                        <t t-if="has_prev">
                                            <li class="page-item">
                                                <a class="page-link" t-att-href="'/media/page/%s' % (page - 1)">Previous</a>
                                            </li>
                                        </t>
                                        <li class="page-item active">
                                            <span class="page-link">Page <t t-esc="page"/> of <t t-esc="total_pages"/></span>
                                        </li>
                                        <t t-if="has_next">
                                            <li class="page-item">
                                                <a class="page-link" t-att-href="'/media/page/%s' % (page + 1)">Next</a>
                                            </li>
                                        </t>
                                    </ul>
                                </nav>
                            </div>
                        </t>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>